# Server
ALIVER_HOST=127.0.0.1
ALIVER_PORT=8765
ALIVER_DATABASE_URL=sqlite:///./data/aliver.db
ALIVER_SECRET_KEY=replace-this-with-a-long-random-string
ALIVER_LOG_LEVEL=INFO
ALIVER_BRIDGE_COMMAND_TIMEOUT=30

# Optional: set this if you expose ALiver beyond localhost.
# API clients must then send X-ALiver-Token.
ALIVER_ADMIN_TOKEN=
