{
  "manifest_version": 3,
  "name": "ALiver ChatGPT Controller",
  "version": "0.1.5",
  "description": "Receives ALiver director commands, binds one ChatGPT conversation, generates director plans in text mode, and reports completed assistant replies.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background_entry.js"
  },
  "action": {
    "default_title": "ALiver Controller",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js", "assistant_capture.js", "planner_content.js"],
      "run_at": "document_idle"
    }
  ]
}
