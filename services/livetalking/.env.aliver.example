# Required. Generate a long random value and use the same value in ALiver Bridge.
ALIVER_STREAM_TOKEN=replace-with-at-least-32-random-characters

# LiveTalking returns video only. Audience audio remains ALiver CABLE-B.
ALIVER_VIDEO_ONLY=1

# Maximum server-side PCM backlog. Oldest frames are dropped above this value.
ALIVER_PCM_MAX_QUEUE_MS=400

# LiveTalking startup arguments used by docker-compose.aliver.yml
LIVETALKING_MODEL=wav2lip
LIVETALKING_AVATAR_ID=wav2lip256_avatar1
LIVETALKING_BATCH_SIZE=8
LIVETALKING_MAX_SESSION=1
LIVETALKING_LISTEN_PORT=8010
LIVETALKING_STUN=stun:stun.freeswitch.org:3478
